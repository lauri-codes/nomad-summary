diff a/pyproject.toml b/pyproject.toml	(rejected hunks)
@@ -74,12 +91,14 @@ select = [
     "UP",
     # isort
     "I",
-    # pylint 
+    # pylint
     "PL",
 ]
 
 ignore = [
     "F403", # 'from module import *' used; unable to detect undefined names
+    "PLC0415", # `import` should be at the top-level of a file
+    "E501", # line too long
 ]
 
 fixable = ["ALL"]
@@ -110,8 +132,10 @@ where = ["src"]
 [project.entry-points.'nomad.plugin']
 
 
-mynormalizer = "nomad_summary.normalizers:mynormalizer"
+normalizer_entry_point = "summary.normalizers:normalizer_entry_point"
 
+example_upload_entry_point = "summary.example_uploads:example_upload_entry_point"
+action_entry_point = "summary.actions:simple_action_entry_point"
 [tool.cruft]
 # Avoid updating workflow files, this leads to permissions issues
 skip = [".github/*"]
